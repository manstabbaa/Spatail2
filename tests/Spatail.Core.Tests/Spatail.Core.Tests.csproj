<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the engine-independent core straight from the Unity package and runs its tests with plain `dotnet run`.
    LangVersion is pinned to what Unity 6 accepts so anything that builds here builds in the editor.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Spatail.Core.Tests</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same binaries the Unity package ships, so tests exercise exactly what runs on device. -->
    <Reference Include="Jint"><HintPath>../../packages/com.spatail.core/Runtime/Plugins/Jint.dll</HintPath></Reference>
    <Reference Include="Acornima"><HintPath>../../packages/com.spatail.core/Runtime/Plugins/Acornima.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../packages/com.spatail.core/Runtime/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>
</Project>
