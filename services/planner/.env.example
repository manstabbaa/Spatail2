# Credentials for Claude. Keep this on the machine that runs the planner service; devices never see it.
ANTHROPIC_API_KEY=

# Optional shared secret. When set, the app must send it (Settings > Planner token).
SPATAIL_TOKEN=

# Optional overrides.
# PORT=8787
# SPATAIL_MODEL=claude-opus-5-5
# SPATAIL_EFFORT=low
