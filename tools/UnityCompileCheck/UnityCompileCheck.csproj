<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Type-checks the Unity-facing runtime without a Unity install or licence:
        dotnet build tools/UnityCompileCheck
    It compiles the shared package sources against Unity's public reference assemblies from NuGet. The reference
    set is Unity 2021.3, older than the editor the apps target, so anything that passes here only uses long-stable
    engine API. Platform adapters (Meta XR, AR Foundation) are not covered; those need their SDKs.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Pass -p:InputSystemDll=/path/to/Unity.InputSystem.dll to check the Input System code path instead of the legacy one. -->
    <DefineConstants Condition="'$(InputSystemDll)' == ''">UNITY_2021_3_OR_NEWER;UNITY_EDITOR;ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <DefineConstants Condition="'$(InputSystemDll)' != ''">UNITY_2021_3_OR_NEWER;UNITY_EDITOR;ENABLE_INPUT_SYSTEM;SPATAIL_INPUT_SYSTEM</DefineConstants>
    <NoWarn>CS0649;CS0414;NU1701</NoWarn>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
  <ItemGroup Condition="'$(InputSystemDll)' != ''">
    <Reference Include="Unity.InputSystem"><HintPath>$(InputSystemDll)</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../packages/com.spatail.core/Runtime/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../packages/com.spatail.core/Runtime/Unity/**/*.cs" LinkBase="Unity" />
  </ItemGroup>
</Project>
